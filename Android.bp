// PcTextEditor: "Text", the plain text editor of LineageOS for PCs. The editor's logic lives in core/
// and is tested on the host.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "PcTextEditorCore",
    host_supported: true,
    srcs: ["core/src/**/*.kt"],
    sdk_version: "core_current",
}

java_test_host {
    name: "PcTextEditorCoreTests",
    srcs: ["core/tests/**/*.kt"],
    static_libs: [
        "PcTextEditorCore",
        "junit",
    ],
    test_options: {
        unit_test: true,
    },
}

android_app {
    name: "PcTextEditor",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    product_specific: true,
    static_libs: [
        "PcTextEditorCore",
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.animation_animation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "kotlinx_coroutines_android",
    ],
    optimize: {
        optimize: true,
        shrink_resources: true,
    },
}
